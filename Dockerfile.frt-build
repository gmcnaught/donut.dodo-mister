# armhf (ARMv7 / Cortex-A9) cross-build image for FRT + Godot 3.x.
# Base image already carries the Debian bullseye armhf cross toolchain
# (glibc 2.31 target == MiSTer's glibc) and armhf multiarch.
FROM gmloader-armhf-build:bullseye

RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
        python3 python3-pip pkg-config xz-utils && \
    pip3 install --no-cache-dir scons==4.5.2 && \
    rm -rf /var/lib/apt/lists/*

# FRT's detect_godot3.py calls "<triple>-pkg-config" when cross compiling.
# Point it at the cross SDL2 we build ourselves (mounted at /src/sdl2-armhf).
RUN printf '#!/bin/sh\nexport PKG_CONFIG_LIBDIR=/src/sdl2-armhf/lib/pkgconfig\nexport PKG_CONFIG_PATH=/src/sdl2-armhf/lib/pkgconfig\nexec pkg-config "$@"\n' \
      > /usr/local/bin/arm-linux-gnueabihf-pkg-config && \
    chmod +x /usr/local/bin/arm-linux-gnueabihf-pkg-config
