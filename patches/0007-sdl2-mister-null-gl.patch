+static Uint32 nullgl_next_name = 1;   /* unique across object types: the glue keys textures by name */
+
+typedef struct NullGLUniform {
+    Uint32 program;
+    char *name;
+    int loc;
+} NullGLUniform;
+static NullGLUniform *nullgl_uniforms;
+static int nullgl_nuniforms, nullgl_capuniforms;
+static int nullgl_next_loc;
+
+SDL_bool MISTER_NULLGL_Enabled(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *glue = SDL_getenv("SDL_MISTER_GLUE");
+        const char *e = SDL_getenv("SDL_MISTER_NULL_GL");
+        SDL_bool glue_on = glue && *glue && SDL_strcmp(glue, "0") != 0;
+        on = (glue_on && !(e && SDL_strcmp(e, "0") == 0)) ? 1 : 0;
+    }
+    return on ? SDL_TRUE : SDL_FALSE;
+}
+
+/* Every entry point without a specific stub: no effect, returns 0. Under the
+   ARM EABI the caller owns the stack, so any signature may call it. */
+static uintptr_t nullgl_zero(void) { return 0; }
+
+static const Uint8 *nullgl_GetString(Uint32 name)
+{
+    switch (name) {
+    case 0x1F00: return (const Uint8 *)NULLGL_VENDOR;       /* GL_VENDOR */
+    case 0x1F01: return (const Uint8 *)NULLGL_RENDERER;     /* GL_RENDERER */
+    case 0x1F02: return (const Uint8 *)NULLGL_VERSION;      /* GL_VERSION */
+    case 0x1F03: return (const Uint8 *)NULLGL_EXTENSIONS;   /* GL_EXTENSIONS */
+    case 0x8B8C: return (const Uint8 *)NULLGL_GLSL;         /* GL_SHADING_LANGUAGE_VERSION */
+    default:     return (const Uint8 *)"";
+    }
+}
+
+static int nullgl_integer(Uint32 pname)
+{
+    switch (pname) {
+    case 0x0D33: /* GL_MAX_TEXTURE_SIZE */
+    case 0x0D3A: /* GL_MAX_VIEWPORT_DIMS */
+    case 0x851C: /* GL_MAX_CUBE_MAP_TEXTURE_SIZE */
+    case 0x84E8: /* GL_MAX_RENDERBUFFER_SIZE */
+        return 16384;
+    case 0x8B4C: /* GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS */
+    case 0x8872: /* GL_MAX_TEXTURE_IMAGE_UNITS */
+        return 32;
+    case 0x8B4D: /* GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS */
+        return 192;
+    case 0x8D57: /* GL_MAX_SAMPLES */
+        return 4;
+    case 0x8869: /* GL_MAX_VERTEX_ATTRIBS */
+        return 16;
+    default:
+        return 0;
+    }
+}
+
+static void nullgl_GetIntegerv(Uint32 pname, int *data)
+{
+    data[0] = nullgl_integer(pname);
+    if (pname == 0x0D3A) {   /* GL_MAX_VIEWPORT_DIMS: two values */
+        data[1] = data[0];
+    }
 }
 
+static void nullgl_GetFloatv(Uint32 pname, float *data)
+{
+    data[0] = (pname == 0x84FF) ? 16.0f : (float)nullgl_integer(pname);   /* 0x84FF: MAX_TEXTURE_MAX_ANISOTROPY_EXT */
+    if (pname == 0x0D3A) {
+        data[1] = data[0];
+    }
+}
+
+static void nullgl_GetBooleanv(Uint32 pname, Uint8 *data)
+{
+    data[0] = nullgl_integer(pname) != 0;
+}
+
+static void nullgl_GenNames(int n, Uint32 *names)
+{
+    int i;
+    for (i = 0; i < n; i++) {
+        names[i] = nullgl_next_name++;
+    }
+}
+
+static Uint32 nullgl_CreateObject(void)
+{
+    return nullgl_next_name++;
+}
+
+static void nullgl_GetObjectiv(Uint32 obj, Uint32 pname, int *params)
+{
+    (void)obj;
+    /* GL_COMPILE_STATUS, GL_LINK_STATUS, GL_VALIDATE_STATUS succeed; lengths and counts are 0. */
+    params[0] = (pname == 0x8B81 || pname == 0x8B82 || pname == 0x8B83) ? 1 : 0;
+}
+
+static void nullgl_GetInfoLog(Uint32 obj, int bufsize, int *length, char *log)
+{
+    (void)obj;
+    if (length) {
+        *length = 0;
+    }
+    if (log && bufsize > 0) {
+        log[0] = 0;
+    }
+}
+
+/* One stable, unique location per (program, name): the glue maps uniform
+   values by location, so two names must never share one. */
+static int nullgl_GetUniformLocation(Uint32 program, const char *name)
+{
+    int i;
+    if (!name) {
+        return -1;
+    }
+    for (i = 0; i < nullgl_nuniforms; i++) {
+        if (nullgl_uniforms[i].program == program && SDL_strcmp(nullgl_uniforms[i].name, name) == 0) {
+            return nullgl_uniforms[i].loc;
+        }
+    }
+    if (nullgl_nuniforms == nullgl_capuniforms) {
+        int cap = nullgl_capuniforms ? nullgl_capuniforms * 2 : 256;
+        NullGLUniform *nu = (NullGLUniform *)SDL_realloc(nullgl_uniforms, cap * sizeof(*nu));
+        if (!nu) {
+            return -1;
+        }
+        nullgl_uniforms = nu;
+        nullgl_capuniforms = cap;
+    }
+    nullgl_uniforms[nullgl_nuniforms].program = program;
+    nullgl_uniforms[nullgl_nuniforms].name = SDL_strdup(name);
+    nullgl_uniforms[nullgl_nuniforms].loc = nullgl_next_loc++;
+    return nullgl_uniforms[nullgl_nuniforms++].loc;
+}
+
+static void nullgl_DeleteProgram(Uint32 program)
+{
+    int i = 0;
+    while (i < nullgl_nuniforms) {
+        if (nullgl_uniforms[i].program == program) {
+            SDL_free(nullgl_uniforms[i].name);
+            nullgl_uniforms[i] = nullgl_uniforms[--nullgl_nuniforms];
+        } else {
+            i++;
+        }
+    }
+}
+
+static Uint32 nullgl_CheckFramebufferStatus(Uint32 target)
+{
+    (void)target;
+    return 0x8CD5;   /* GL_FRAMEBUFFER_COMPLETE */
+}
+
+static const struct { const char *name; void *fn; } nullgl_entries[] = {
+    { "glGetString", (void *)nullgl_GetString },
+    { "glGetIntegerv", (void *)nullgl_GetIntegerv },
+    { "glGetFloatv", (void *)nullgl_GetFloatv },
+    { "glGetBooleanv", (void *)nullgl_GetBooleanv },
+    { "glGenBuffers", (void *)nullgl_GenNames },
+    { "glGenTextures", (void *)nullgl_GenNames },
+    { "glGenFramebuffers", (void *)nullgl_GenNames },
+    { "glGenRenderbuffers", (void *)nullgl_GenNames },
+    { "glGenVertexArraysOES", (void *)nullgl_GenNames },
+    { "glCreateProgram", (void *)nullgl_CreateObject },
+    { "glCreateShader", (void *)nullgl_CreateObject },
+    { "glDeleteProgram", (void *)nullgl_DeleteProgram },
+    { "glGetShaderiv", (void *)nullgl_GetObjectiv },
+    { "glGetProgramiv", (void *)nullgl_GetObjectiv },
+    { "glGetShaderInfoLog", (void *)nullgl_GetInfoLog },
+    { "glGetProgramInfoLog", (void *)nullgl_GetInfoLog },
+    { "glGetUniformLocation", (void *)nullgl_GetUniformLocation },
+    { "glCheckFramebufferStatus", (void *)nullgl_CheckFramebufferStatus },
+};
+
+void *MISTER_NULLGL_GetProcAddress(const char *proc)
+{
+    size_t i;
+    if (!proc) {
+        return NULL;
+    }
+    for (i = 0; i < SDL_arraysize(nullgl_entries); i++) {
+        if (SDL_strcmp(nullgl_entries[i].name, proc) == 0) {
+            return nullgl_entries[i].fn;
+        }
+    }
+    return (void *)nullgl_zero;
+}
