+#ifdef SDL_JOYSTICK_MISTER
+/* [MiSTer] With SDL_MISTER_JOY set, the DDR driver is the ONLY joystick source.
+   This used to be enforced in SDL_JoystickInit alone, which is not enough: the
+   array is walked in four other places, and SDL_JoystickDetect() calls Detect()
+   on every driver whether or not its Init ran. LINUX_JoystickDetect then scans
+   /dev/input, finds the pad MiSTer holds an exclusive EVDEV grab on, and adds a
+   joystick that can never report an event -- taking a low index while the DDR
+   device that does work sits behind it. Measured on device 2026-08-24: with the
+   Init-only skip, frt had /dev/input/event2 (the 8BitDo) open and the DDR
+   joystick words at 0x3BF40008 changed under a press while the engine saw
+   nothing. Suppress everywhere the array is walked, so the counts, the
+   index->driver mapping, Detect and Quit all agree on one driver. */
+static SDL_bool SDL_JoystickDriverSuppressed(SDL_JoystickDriver *driver)
+{
+    static int mister_only = -1;
+
+    if (driver == &SDL_MISTER_JoystickDriver) {
+        return SDL_FALSE;
+    }
+    if (mister_only < 0) {
+        mister_only = SDL_GetHintBoolean("SDL_MISTER_JOY", SDL_FALSE) ? 1 : 0;
+    }
+    return mister_only ? SDL_TRUE : SDL_FALSE;
+}
+#else
+#define SDL_JoystickDriverSuppressed(driver) SDL_FALSE
+#endif
 
