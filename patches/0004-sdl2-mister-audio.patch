+/*
+  MiSTer FPGA audio driver.
+
+  MiSTer has no usable Linux sound path under a core: the FPGA produces the
+  audio. The core's gm_audio module drains a DDR3 ring of stereo S16 frames and
+  mixes them into the MiSTer audio output, so "playing" here means copying into
+  that ring and advancing a write pointer the FPGA polls.
+
+  Ring contract (fpga/rtl/gm_audio.sv, mirrored from gmloader's
+  native_audio_writer.c — the two must agree byte for byte):
+    0x3A000030  wr_ptr  byte offset into the ring; we own it
+    0x3A000038  rd_ptr  byte offset; the FPGA owns it
+    0x3A0D0000  ring    65,536 bytes = 16,384 stereo frames
+
+  The ring carries the game's native rate: gm_audio's SRC_RATE parameter must
+  equal the rate we open at, since that constant drives its resampler to the
+  48 kHz output. This core is built with SRC_RATE = 48000 for Godot's mixer.
+
+  Selected with SDL_AUDIODRIVER=mister.
+*/
+#include "../../SDL_internal.h"
+
+#ifdef SDL_AUDIO_DRIVER_MISTER
+
+#include "SDL_timer.h"
+#include "SDL_audio.h"
+#include "../SDL_audio_c.h"
+#include "SDL_misteraudio.h"
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#define MA_DDR_PHYS_BASE 0x3A000000u
+#define MA_MAP_LEN       0x000E0000u   /* covers the pointers and the ring */
+#define MA_WR_PTR_OFF    0x00000030u
+#define MA_RD_PTR_OFF    0x00000038u
+#define MA_RING_OFF      0x000D0000u
+#define MA_RING_BYTES    0x00010000u
+#define MA_RING_MASK     (MA_RING_BYTES - 1u)
+#define MA_BYTES_PER_FRAME 4          /* stereo int16 */
+/* The ring's rate is gm_audio's SRC_RATE — raise both together, never one.
+   48000 matches the core's output tick exactly, so the ring runs at unity ratio:
+   every frame we write is a frame the DAC emits, with no resampling on either
+   side of the boundary. Godot mixes at 48 kHz, so nothing converts at all. */
+#define MA_RATE          48000
+
+static int              ma_mem_fd = -1;
+static volatile Uint8  *ma_base;
+static volatile Uint8  *ma_ring;
+static volatile Uint32 *ma_wr_reg;
+static volatile Uint32 *ma_rd_reg;
+static Uint32           ma_local_wr;
+
+static SDL_bool MISTERAUDIO_Map(void)
+{
+    void *map;
+
+    if (ma_base) {
+        return SDL_TRUE;
+    }
+    ma_mem_fd = open("/dev/mem", O_RDWR | O_SYNC);
+    if (ma_mem_fd < 0) {
+        return SDL_FALSE;
+    }
+    map = mmap(NULL, MA_MAP_LEN, PROT_READ | PROT_WRITE, MAP_SHARED,
+               ma_mem_fd, MA_DDR_PHYS_BASE);
+    if (map == MAP_FAILED) {
+        close(ma_mem_fd);
+        ma_mem_fd = -1;
+        return SDL_FALSE;
+    }
+    ma_base   = (volatile Uint8 *)map;
+    ma_ring   = ma_base + MA_RING_OFF;
+    ma_wr_reg = (volatile Uint32 *)(ma_base + MA_WR_PTR_OFF);
+    ma_rd_reg = (volatile Uint32 *)(ma_base + MA_RD_PTR_OFF);
+    return SDL_TRUE;
+}
+
+static void MISTERAUDIO_Unmap(void)
+{
+    if (ma_base) {
+        if (ma_wr_reg) {
+            *ma_wr_reg = 0;
+        }
+        munmap((void *)ma_base, MA_MAP_LEN);
+        ma_base = NULL;
+    }
+    if (ma_mem_fd >= 0) {
+        close(ma_mem_fd);
+        ma_mem_fd = -1;
+    }
+    ma_ring = NULL;
+    ma_wr_reg = ma_rd_reg = NULL;
+    ma_local_wr = 0;
+}
+
+/* Free space in bytes, leaving one frame so a full ring is distinguishable
+   from an empty one — the same convention the FPGA side assumes. */
+static Uint32 MISTERAUDIO_FreeBytes(void)
+{
+    Uint32 rd, used;
+
+    if (!ma_rd_reg) {
+        return 0;
+    }
+    rd = *ma_rd_reg;
+    used = (ma_local_wr - rd) & MA_RING_MASK;
+    return (MA_RING_BYTES - MA_BYTES_PER_FRAME) - used;
+}
+
+static int MISTERAUDIO_OpenDevice(_THIS, const char *devname)
+{
+    (void)devname;
+
+    if (!MISTERAUDIO_Map()) {
+        return SDL_SetError("MiSTer audio: cannot map the DDR ring (need /dev/mem as root)");
+    }
+
+    /* The ring format is fixed by the hardware, so refuse to negotiate: the
+       engine's converter will adapt to this rather than us mangling frames. */
+    _this->spec.freq = MA_RATE;
+    _this->spec.format = AUDIO_S16LSB;
+    _this->spec.channels = 2;
+    /* Hold the period well under the ring size. SDL's default (4096 frames) is a
+       quarter of the 16384-frame ring, which makes "wait for one period of room"
+       equivalent to "keep the ring nearly full" — and gm_audio's rate-matching
+       slew then tracks that stalled producer instead of the sink rate. */
+    _this->spec.samples = 1024;
+    SDL_CalculateAudioSpec(&_this->spec);
+
+    _this->hidden = (struct SDL_PrivateAudioData *)SDL_calloc(1, sizeof(*_this->hidden));
+    if (!_this->hidden) {
+        return SDL_OutOfMemory();
+    }
+    _this->hidden->mixbuf = (Uint8 *)SDL_malloc(_this->spec.size);
+    if (!_this->hidden->mixbuf) {
+        return SDL_OutOfMemory();
+    }
+    _this->hidden->mixlen = _this->spec.size;
+
+    SDL_memset((void *)ma_ring, 0, MA_RING_BYTES);
+    *ma_wr_reg = 0;
+    ma_local_wr = 0;
+
+    SDL_Log("MiSTer audio: ring open, %d Hz stereo S16, %u-frame buffer",
+            MA_RATE, (unsigned)_this->spec.samples);
+    return 0;
+}
+
+static Uint8 *MISTERAUDIO_GetDeviceBuf(_THIS)
+{
+    return _this->hidden->mixbuf;
+}
+
+static void MISTERAUDIO_PlayDevice(_THIS)
+{
+    Uint32 bytes = _this->hidden->mixlen;
+    Uint32 freeb = MISTERAUDIO_FreeBytes();
+    Uint32 offset, tail;
+    const Uint8 *src = _this->hidden->mixbuf;
+
+    if (!ma_ring) {
+        return;
+    }
+    /* Drop rather than overwrite unread audio: a late frame is better than a
+       torn one, and WaitDevice should normally have made room already. */
+    if (bytes > freeb) {
+        bytes = freeb & ~(Uint32)(MA_BYTES_PER_FRAME - 1);
+        if (bytes == 0) {
+            return;
+        }
+    }
+
+    offset = ma_local_wr & MA_RING_MASK;
+    tail = MA_RING_BYTES - offset;
+    if (bytes <= tail) {
+        SDL_memcpy((void *)(ma_ring + offset), src, bytes);
+    } else {
+        SDL_memcpy((void *)(ma_ring + offset), src, tail);
+        SDL_memcpy((void *)ma_ring, src + tail, bytes - tail);
+    }
+
+    __sync_synchronize();   /* frames land before the pointer the FPGA polls */
+
+    ma_local_wr = (ma_local_wr + bytes) & MA_RING_MASK;
+    *ma_wr_reg = ma_local_wr;
+}
+
+/* Bytes currently queued for the FPGA. */
+static Uint32 MISTERAUDIO_UsedBytes(void)
+{
+    if (!ma_rd_reg) {
+        return 0;
+    }
+    return (ma_local_wr - *ma_rd_reg) & MA_RING_MASK;
+}
+
+static void MISTERAUDIO_WaitDevice(_THIS)
+{
+    /* Hold a target queue depth rather than filling the ring: a full ring makes
+       every submit a partial write and starves the consumer's rate estimate.
+       Three periods (~64 ms at 1024 frames) matches the latency the engine asks
+       for and leaves the FPGA a comfortable margin. The spin cap keeps a stalled
+       consumer from hanging the audio thread. */
+    const Uint32 target = _this->hidden->mixlen * 3;
+    const Uint32 need = _this->hidden->mixlen;
+    int spins = 0;
+
+    while ((MISTERAUDIO_UsedBytes() > target || MISTERAUDIO_FreeBytes() < need) &&
+           spins++ < 500) {
+        SDL_Delay(1);
+    }
+}
+
+static void MISTERAUDIO_CloseDevice(_THIS)
+{
+    if (_this->hidden) {
+        SDL_free(_this->hidden->mixbuf);
+        SDL_free(_this->hidden);
+        _this->hidden = NULL;
+    }
+    MISTERAUDIO_Unmap();
+}
+
+static SDL_bool MISTERAUDIO_Init(SDL_AudioDriverImpl *impl)
+{
+    /* Probe the mapping here so a non-MiSTer host silently falls through to the
+       next driver instead of opening a device that can never play. */
+    if (!MISTERAUDIO_Map()) {
+        return SDL_FALSE;
+    }
+
+    impl->OpenDevice = MISTERAUDIO_OpenDevice;
+    impl->PlayDevice = MISTERAUDIO_PlayDevice;
+    impl->WaitDevice = MISTERAUDIO_WaitDevice;
+    impl->GetDeviceBuf = MISTERAUDIO_GetDeviceBuf;
+    impl->CloseDevice = MISTERAUDIO_CloseDevice;
+
+    impl->OnlyHasDefaultOutputDevice = SDL_TRUE;
+    impl->HasCaptureSupport = SDL_FALSE;
+
+    return SDL_TRUE;
+}
+
+AudioBootStrap MISTERAUDIO_bootstrap = {
+    "mister", "MiSTer FPGA DDR audio ring", MISTERAUDIO_Init, SDL_FALSE
+};
+
+#endif /* SDL_AUDIO_DRIVER_MISTER */
--- a/src/audio/mister/SDL_misteraudio.h
+++ b/src/audio/mister/SDL_misteraudio.h
@@ -0,0 +1,16 @@
+#ifndef SDL_misteraudio_h_
+#define SDL_misteraudio_h_
+
+#include "../SDL_sysaudio.h"
+
+/* SDL_sysaudio.h #undefs _THIS once it is done declaring the driver interface,
+   so every backend re-establishes it for its own function signatures. */
+#define _THIS SDL_AudioDevice *_this
+
+struct SDL_PrivateAudioData
+{
+    Uint8 *mixbuf;
+    Uint32 mixlen;
+};
+
+#endif /* SDL_misteraudio_h_ */
