--- /tmp/SDL_egl.c.orig	2026-08-22 21:17:17
+++ SDL2-2.32.10/src/video/SDL_egl.c	2026-08-22 21:17:17
@@ -566,7 +566,30 @@
    (eglInitialize() will fail) then attempt to automatically and silently select the next
    valid available GPU for EGL to use.
 */
+
+/* MiSTer: the device has no /dev/dri and ships a surfaceless-only Mesa, so
+   EGL_EXT_device_enumeration reports zero devices and the stock offscreen path
+   fails. Fall back to eglGetDisplay(EGL_DEFAULT_DISPLAY), which Mesa resolves
+   through EGL_PLATFORM=surfaceless. */
+static int SDL_EGL_InitializeOffscreenDefaultDisplay(_THIS)
+{
+    EGLDisplay display;
+
+    display = _this->egl_data->eglGetDisplay((NativeDisplayType)EGL_DEFAULT_DISPLAY);
+    if (display == EGL_NO_DISPLAY) {
+        return SDL_SetError("eglGetDisplay(EGL_DEFAULT_DISPLAY) failed");
+    }
+    if (_this->egl_data->eglInitialize(display, NULL, NULL) != EGL_TRUE) {
+        return SDL_SetError("Could not initialize EGL on the default display");
+    }
 
+    _this->egl_data->egl_display = display;
+    SDL_EGL_GetVersion(_this);
+    _this->egl_data->is_offscreen = SDL_TRUE;
+
+    return 0;
+}
+
 int SDL_EGL_InitializeOffscreen(_THIS, int device)
 {
     void *egl_devices[SDL_EGL_MAX_DEVICES];
